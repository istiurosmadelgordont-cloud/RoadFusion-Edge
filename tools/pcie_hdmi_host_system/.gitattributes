# ---------------------------------------------------------------------------
# 统一换行符：本仓库在 Windows 上开发（core.autocrlf=true），
# 而这些源码要在 Linux 板端编译运行，统一存 LF 可避免 checkout 差异。
# ---------------------------------------------------------------------------

*.py		text eol=lf
*.sh		text eol=lf
*.c		text eol=lf
*.h		text eol=lf
*.md		text eol=lf
*.txt		text eol=lf
Makefile	text eol=lf
