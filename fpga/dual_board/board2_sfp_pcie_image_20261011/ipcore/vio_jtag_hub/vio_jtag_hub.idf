<?xml version="1.0" encoding="UTF-8"?>
<ip_inst>
    <header>
        <vendor>Pango</vendor>
        <id>06200702</id>
        <display_name>Dvio_Jtag_Hub</display_name>
        <name>Dvio_Jtag_Hub</name>
        <version>1.0</version>
        <instance>vio_jtag_hub</instance>
        <family>Logos</family>
        <device>PGL50H</device>
        <package>FBG484</package>
        <speedgrade>-6</speedgrade>
        <generator version="2022.2-SP6.4" build="146967">IP Compiler</generator>
    </header>
    <param_list>
        <param>
            <name>UJTAG_SEL_TEXT</name>
            <item>Default JTAG</item>
            <value>Default JTAG</value>
        </param>
        <param>
            <name>PGL_DEVICE</name>
            <value>false</value>
        </param>
        <param>
            <name>UJTAG_SEL</name>
            <value>0</value>
        </param>
        <param>
            <name>PGT_DEVICE_30G</name>
            <value>false</value>
        </param>
        <param>
            <name>CTRL_PORT_NUM</name>
            <value>1</value>
        </param>
        <param>
            <name>PGT_DEVICE</name>
            <value>false</value>
        </param>
    </param_list>
    <pin_list>
        <pin>
            <name>resetn_i</name>
            <text>resetn_i</text>
            <dir>input</dir>
            <pos>left</pos>
        </pin>
        <pin>
            <name>drck_o</name>
            <text>drck_o</text>
            <dir>output</dir>
            <pos>right</pos>
        </pin>
        <pin>
            <name>hub_tdi</name>
            <text>hub_tdi</text>
            <dir>output</dir>
            <pos>right</pos>
        </pin>
        <pin>
            <name>capt_o</name>
            <text>capt_o</text>
            <dir>output</dir>
            <pos>right</pos>
        </pin>
        <pin>
            <name>shift_o</name>
            <text>shift_o</text>
            <dir>output</dir>
            <pos>right</pos>
        </pin>
        <pin>
            <name>conf_sel</name>
            <text>conf_sel</text>
            <dir>output</dir>
            <pos>right</pos>
            <msb>14</msb>
            <lsb>0</lsb>
        </pin>
        <pin>
            <name>id_o</name>
            <text>id_o</text>
            <dir>output</dir>
            <pos>right</pos>
            <msb>8</msb>
            <lsb>0</lsb>
        </pin>
        <pin>
            <name>hub_tdo</name>
            <text>hub_tdo</text>
            <dir>input</dir>
            <pos>right</pos>
            <msb>14</msb>
            <lsb>0</lsb>
        </pin>
    </pin_list>
    <synthesis>
        <script><![CDATA[set_option -vlog_std v2001]]></script>
        <script><![CDATA[set_option -disable_io_insertion 1]]></script>
    </synthesis>
    <file_list>
        <output>
            <file pathname="generate.log" format="log" description="Generate Log"/>
            <file pathname="vio_jtag_hub_tmpl.v" format="verilog" description="Instantiation Template"/>
            <file pathname="vio_jtag_hub_tmpl.vhdl" format="vhdl" description="Instantiation Template"/>
        </output>
        <source>
            <file pathname="rtl/ips_dvio_jtag_hub_v1_0.v"/>
            <file pathname="vio_jtag_hub.v"/>
        </source>
    </file_list>
</ip_inst>
